# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
*.swp

# Env / secrets — never commit these
.env
.env.*
*.pem
*.key
credentials.json

# Large data & weights (root level only)
/data/
/weights/
*/weights/
*/weights-*
*/*.zip
*.pt
*.pth

# Temporary & single-use scratch files (root level only)
/scratch/
/results/
*.tmp
*.tmp.*
*.log

# Python / Environment
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
.pytest_cache/
# --- Run artifacts (logging/tracking/archiving upgrade) --------------------
# Per-run logs & structured tracking (regenerated on every run, never commit)
run_logs/
**/run_logs/

# Archives produced by scripts/archive_results.py
archives/

# Regenerable plot images inside result runs (metric JSON/CSV are kept)
results/**/plots/
saves/results/**/plots/

# Colab / local scratch
/cross_eval_*/
